# Copie para .env e ajuste os valores:  cp .env.example .env

# ── Postgres ─────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# ── Backend (FastAPI) ────────────────────────────────────
DATABASE_URL=postgresql://app:change-me@postgres:5432/app
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents

# ── LLM ("provider:model") ───────────────────────────────
# Ex.: groq:llama-3.3-70b-versatile | openai:gpt-4o-mini | anthropic:claude-sonnet-4-5
LLM_MODEL=
LLM_TEMPERATURE=0

# ── Embeddings ("provider:model") ────────────────────────
# Ex.: nvidia:nvidia/nv-embed-v1 | openai:text-embedding-3-small
# Precisa ser o mesmo modelo usado para indexar a coleção do Qdrant.
EMBEDDING_MODEL=

# ── Chaves dos providers (só as que você usar) ───────────
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
